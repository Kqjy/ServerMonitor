POSTGRES_USER=servermonitor
POSTGRES_PASSWORD=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-a-long-random-string
# Cold metrics archive (ServerMonitor -> S3). ARCHIVE_S3_* is canonical.
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=
ARCHIVE_S3_PREFIX=metrics
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_USE_PATH_STYLE=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_SESSION_TOKEN=
# Deprecated cold-archive aliases; retained for existing deployments.
S3_BUCKET=
S3_REGION=
S3_PREFIX=
S3_ENDPOINT=
S3_USE_PATH_STYLE=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LOG_LEVEL=info
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUST_PROXY_TLS=
INSECURE_ALLOW_HTTP=1
TRUSTED_PROXIES=
AGENT_SIGNING_KEY_FILE=/data/agent_signing.key
BACKUP_DIR=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_USE_PATH_STYLE=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SESSION_TOKEN=
# Stable 32-byte base64/hex key for centrally managed direct-S3 credentials.
# Generate once with: openssl rand -base64 32
BACKUP_SECRETS_KEY=
BACKUP_WG_PORT=
BACKUP_WG_ENDPOINT=
BACKUP_WG_SUBNET=10.83.0.0/16
BACKUP_WG_MTU=1280
BACKUP_PUBLIC_HTTP=
